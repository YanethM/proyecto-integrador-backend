{
  "openapi": "3.0.3",
  "info": {
    "title": "Registro grupo 2",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ],
  "paths": {
    "/auth/registro": {
      "post": {
        "summary": "Registrar usuario del grupo 2",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "nombre",
                  "correo",
                  "clave"
                ],
                "properties": {
                  "nombre": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  "correo": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "clave": {
                    "type": "string",
                    "minLength": 12,
                    "description": "Máximo 72 bytes UTF-8",
                    "writeOnly": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado; devuelve id, nombre, correo y creadoEn, sin clave"
          },
          "400": {
            "description": "Datos o JSON inválidos"
          },
          "409": {
            "description": "Correo ya registrado"
          },
          "413": {
            "description": "Cuerpo mayor de 16 KB"
          },
          "429": {
            "description": "Más de 20 intentos por IP en 15 minutos"
          },
          "503": {
            "description": "Registro no disponible"
          },
          "403": {
            "description": "Origen no autorizado por CORS"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Verificar conexión a PostgreSQL",
        "responses": {
          "200": {
            "description": "Base disponible; status ok"
          },
          "503": {
            "description": "Base no disponible; status unavailable"
          }
        }
      }
    }
  }
}
